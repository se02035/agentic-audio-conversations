{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Audio Conversation: CLI --help",
      "type": "debugpy",
      "request": "launch",
      "module": "tts_audio_conversation.cli",
      "args": ["--help"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Audio Conversation: Generate Template (YAML)",
      "type": "debugpy",
      "request": "launch",
      "module": "tts_audio_conversation.cli",
      "args": ["template", "--language", "en-US", "--output", "scratch/template_en.yaml"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Audio Conversation: Validate Script",
      "type": "debugpy",
      "request": "launch",
      "module": "tts_audio_conversation.cli",
      "args": ["validate", "--script", "scratch/template_en.yaml"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Audio Conversation: Synthesize local WAV",
      "type": "debugpy",
      "request": "launch",
      "module": "tts_audio_conversation.cli",
      "args": [
        "synthesize",
        "--script",
        "scratch/template_en.yaml",
        "--output",
        "scratch/template_en.wav"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Debug Current Test File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Audio Conversation: MCP HTTP",
      "type": "debugpy",
      "request": "launch",
      "module": "tts_audio_conversation.mcp",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "ADK Web: Audio Overview Agent",
      "type": "debugpy",
      "request": "launch",
      "module": "google.adk.cli",
      "args": [
        "web",
        "--host",
        "127.0.0.1",
        "--port",
        "8080",
        "--no-reload",
        "src/tts_audio_conversation/adk"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOOGLE_CLOUD_LOCATION": "global",
        "GOOGLE_GENAI_USE_VERTEXAI": "true",
        "GOOGLE_GENAI_USE_ENTERPRISE": "true",
        "AUDIO_CONVERSATION_MCP_URL": "http://127.0.0.1:8000/mcp"
      }
    },
    {
      "name": "ADK A2A: Audio Overview Agent",
      "type": "debugpy",
      "request": "launch",
      "module": "tts_audio_conversation.adk.a2a",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOOGLE_CLOUD_LOCATION": "global",
        "GOOGLE_GENAI_USE_VERTEXAI": "true",
        "GOOGLE_GENAI_USE_ENTERPRISE": "true",
        "AUDIO_CONVERSATION_MCP_URL": "http://127.0.0.1:8000/mcp"
      }
    }
  ],
  "compounds": [
    {
      "name": "Audio Overview: MCP + ADK Web",
      "configurations": [
        "Audio Conversation: MCP HTTP",
        "ADK Web: Audio Overview Agent"
      ],
      "stopAll": true
    },
    {
      "name": "Audio Overview: MCP + A2A Agent",
      "configurations": [
        "Audio Conversation: MCP HTTP",
        "ADK A2A: Audio Overview Agent"
      ],
      "stopAll": true
    }
  ]
}
