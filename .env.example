# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# MCP server: EU bucket name (gs:// prefix optional). Required for tts-podcast-mcp.
PODCAST_GCS_BUCKET=your-eu-bucket-name
PODCAST_GCS_PREFIX=podcasts

# Integration test GCS destination (EU bucket). Unique suffixes are appended at runtime.
PODCAST_TEST_GCS_URI=gs://your-eu-bucket-name/podcasts/integration_test.wav

# Set to 'true' to keep GCS objects created by integration tests.
KEEP_TEST_ARTIFACTS=false

# Optional script payload cap (bytes) and in-flight TTS cap for MCP jobs.
# PODCAST_MAX_SCRIPT_BYTES=512000
# PODCAST_MAX_CONCURRENT_JOBS=4
# PODCAST_JOB_STALE_TTL_SEC=1800
# PODCAST_JOB_PRUNE_TTL_SEC=3600
# PODCAST_TRANSLATE_MAX_CHARS=8000

# FastMCP Streamable HTTP (anonymous). Endpoint: http://127.0.0.1:8000/mcp
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# OpenTelemetry: comma list of exporters (console = stderr, gcp = Cloud Trace).
# OTEL_SERVICE_NAME=tts-podcast-creator
# OTEL_TRACES_EXPORTER=console,gcp

# Optional: service account key if not using `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account_key.json
