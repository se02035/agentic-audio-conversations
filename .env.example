# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# EU bucket name (gs:// prefix optional). Required by both the CLI and the MCP server.
AUDIO_CONVERSATION_GCS_STAGING_BUCKET=your-eu-bucket-name
AUDIO_CONVERSATION_GCS_PREFIX=conversation

# Integration test GCS destination (EU bucket). Unique suffixes are appended at runtime.
AUDIO_CONVERSATION_TEST_GCS_URI=gs://your-eu-bucket-name/conversation/integration_test.wav

# Set to 'true' to keep GCS objects created by integration tests.
KEEP_TEST_ARTIFACTS=false

# Optional script payload cap (bytes) and in-flight TTS cap for MCP jobs.
# AUDIO_CONVERSATION_MAX_SCRIPT_BYTES=512000
# AUDIO_CONVERSATION_MAX_CONCURRENT_JOBS=4
# AUDIO_CONVERSATION_JOB_PRUNE_TTL_SEC=3600
# AUDIO_CONVERSATION_TRANSLATE_MAX_CHARS=8000

# FastMCP Streamable HTTP (anonymous). Endpoint: http://127.0.0.1:8000/mcp
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# OpenTelemetry: comma list of exporters (console = stderr, gcp = Cloud Trace).
# OTEL_SERVICE_NAME=tts-audio-conversation
# OTEL_TRACES_EXPORTER=console,gcp

# Optional: service account key if not using `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account_key.json

# ADK agent (optional extra: uv sync --extra adk). Playground: adk web.
# Automated tests: real adk api_server under tests/integration/adk/
# (https://adk.dev/runtime/api-server/). Unit tests do not spawn the server.
# Gemini uses the global Vertex/Gemini Enterprise endpoint via ADC.
# Speech/translation stay on EU endpoints in the MCP process — do not point the
# ADK process at an EU Gemini location.
# Enable aiplatform.googleapis.com (or Gemini Enterprise) for the model.
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=global
# ADK_AGENT_MODEL=gemini-3.8-flash
# ADK_LLM_RETRY_ATTEMPTS=5
# ADK_LLM_RETRY_INITIAL_DELAY=1.0
# ADK_LLM_RETRY_MAX_DELAY=16.0
# AUDIO_CONVERSATION_MCP_URL=http://127.0.0.1:8000/mcp
# AUDIO_CONVERSATION_JOB_POLL_INTERVAL_SEC=5
# AUDIO_CONVERSATION_JOB_POLL_TIMEOUT_SEC=1800

# ADK A2A Agent (Agent-to-Agent protocol server via `to_a2a`)
# ADK_A2A_HOST=127.0.0.1
# ADK_A2A_PORT=8001
# ADK_A2A_PROTOCOL=http
# ADK_A2A_RPC_PATH=
# ADK_A2A_AGENT_CARD_PATH=
# ADK_A2A_AGENT_ENDPOINT=https://my-tunnel.ngrok.app   # Advertised public URL in Agent Card
# TUNNEL_ADDRESS=https://my-tunnel.ngrok.app           # Alternative tunnel address alias

